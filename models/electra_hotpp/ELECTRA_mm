    @staticmethod
    def normalized_l1_loss(pred: torch.Tensor, target: torch.Tensor, eps: float = 1e-8) -> torch.Tensor:
        """Compute mean absolute percentage error between prediction and target.

        Args:
            pred (torch.Tensor): Predicted energy values.
            target (torch.Tensor): Ground truth energy values.
            eps (float, optional): Small constant to avoid division by zero.

        Returns:
            torch.Tensor: Normalized L1 loss.
        """
        return torch.mean(torch.abs(pred - target) / (torch.abs(target) + eps))

    def _get_entry_identifier(self, identifier: str | None, batch_idx: int) -> str:
        if identifier:
            base = os.path.basename(identifier)
            return base.split(".")[0]
        return f"batch_{batch_idx}"

    def forward(self,
                atoms,
                state_attr: torch.Tensor | None = None,
                n_elec: int | None = None,
                rotation_matrix: torch.Tensor | None = None,
                orig_pos: torch.Tensor | None = None,
                **kwargs):
        """

        Args:
            g : DGLGraph for a batch of graphs.
            state_attr: State attrs for a batch of graphs.
            **kwargs: For future flexibility. Not used at the moment.

        Returns:
            output: output: Output property for a batch of graphs
        """
        start = time.time()
        # Obtain graph, with distances and relative position vectors
        atoms.pbc = self.config['pbc']
        wrap = self.config['wrap']
        idx_i, idx_j, offsets = neighbor_list("ijS", atoms, self.cutoff, self_interaction=False)
        offset = np.array(offsets) @ atoms.get_cell()
        if not atoms.pbc.all():
            offset = torch.zeros_like(torch.tensor(offset, dtype=self.precision, device=self.device))
        data = {
            "atomic_number": torch.tensor(atoms.numbers, dtype=torch.long, device=self.device),
            "idx_i": torch.tensor(idx_i, dtype=torch.long, device=self.device),
            "idx_j": torch.tensor(idx_j, dtype=torch.long, device=self.device),
            "coordinate": torch.tensor(atoms.positions, dtype=self.precision, device=self.device),
            "n_atoms": torch.tensor([len(atoms)], dtype=torch.long, device=self.device),
            "offset": torch.tensor(offset, dtype=self.precision, device=self.device),
            "scaling": torch.eye(3, dtype=self.precision, device=self.device).view(1, 3, 3),
            "batch": torch.zeros(len(atoms), dtype=torch.long, device=self.device),
            "cell": torch.tensor(atoms.cell[:], dtype=self.precision, device=self.device),
        }
        at_numbers = data['atomic_number']
        X_scal_full, X_vec_full, X_tens_full, init_emb = self.base_model(batch_data=data,
                                                                         properties=None,
                                                                          create_graph=False)
        atom_count = len(at_numbers)
        X_scal = X_scal_full[0]
        X_scal_vec = X_scal_full[1]
        X_scal_tens = X_scal_full[2]

        X_vec_scal = X_vec_full[0]
        X_vec = X_vec_full[1]
        X_vec_tens = X_vec_full[2]

        X_tens_scal = X_tens_full[0]
        X_tens_vec = X_tens_full[1]
        X_tens = X_tens_full[2]

        valence_tensor = torch.tensor([valence_electrons(chemical_symbols[atom]) for atom in at_numbers], device=self.device)
        #valence_tensor = torch.ones_like(valence_tensor, device=self.device)
        #valence_tensor = at_numbers
        scalar_features = X_scal.view(atom_count, -1)
        print(scalar_features.shape,'before mapping to energy dim')
        scalar_features = self.map_to_energy_dim(scalar_features)
        print(scalar_features.shape,'after mapping to energy dim')

        l1_scalar_features = None
        if self.use_l1_energy_features:
            vec_channels = X_vec.view(atom_count, self.hotpp_outdim, 3)
            # Apply the shared linear mixing along the channel dimension while
            # leaving the coordinate axis untouched so the operation commutes
            # with rigid rotations. The norm over coordinates then produces
            # rotationally invariant scalars sized by l1_energy_out_dim.
            mixed_vec = self.l1_energy_linear(vec_channels.transpose(1, 2)).transpose(1, 2)
            l1_scalar_features = torch.linalg.norm(mixed_vec, dim=-1)

        energy_readout_input = scalar_features if l1_scalar_features is None else torch.cat((scalar_features, l1_scalar_features), dim=-1)
        #print('final shapes are here biitch', scalar_features.shape, l1_scalar_features.shape, energy_readout_input.shape)
        # Compute the element-wise minimum between valence_tensor and fixed_value_tensor
        n_multiples = valence_tensor * self.units
        n_multiples = n_multiples.to(self.device)
        atom_embeds = init_emb.repeat_interleave(valence_tensor, dim=0)

        # Concatenate the selected slices along the first dimension
        n_atoms = torch.sum(valence_tensor)

        X_scal = self.slice(X_scal, n_multiples).view(n_atoms, self.units)
        X_scal_vec = self.slice(X_scal_vec, n_multiples).view(n_atoms, self.units, 3)
        X_scal_tens = self.slice(X_scal_tens, n_multiples).view(n_atoms, self.units, 3, 3)

        X_vec_scal = self.slice(X_vec_scal, n_multiples).view(n_atoms, self.units)
        X_vec = self.slice(X_vec, n_multiples).view(n_atoms, self.units, 3)
        X_vec_tens = self.slice(X_vec_tens, n_multiples).view(n_atoms, self.units, 3, 3)

        X_tens_scal = self.slice(X_tens_scal, n_multiples).view(n_atoms, self.units)
        X_tens_vec = self.slice(X_tens_vec, n_multiples).view(n_atoms, self.units, 3)
        X_tens = self.slice(X_tens, n_multiples).view(n_atoms, self.units, 3, 3)

        pos_disp = X_vec.view(-1, 3)
        pos_disp_2 = X_scal_vec.view(-1, 3)
        pos_disp_3 = X_tens_vec.view(-1, 3)

        wsm_ = torch.cat((atom_embeds[:, :self.units], X_scal, X_vec_scal, X_tens_scal), dim=-1).view(n_atoms, -1)
    

        wsm2 = torch.cat((X_scal, X_vec_scal, X_tens_scal), dim=-1).view(n_atoms, -1)
        # Compute determinants of l=2 tensor features
        det_scal = torch.det(X_scal_tens.view(-1, 3, 3)).view(n_atoms, self.units)
        det_vec = torch.det(X_vec_tens.view(-1, 3, 3)).view(n_atoms, self.units)
        det_tens = torch.det(X_tens.view(-1, 3, 3)).view(n_atoms, self.units)

        pos_scalars = self.pos_factors_network(wsm_)
        matrix_scalars = self.matrix_factors_network(wsm_)
        wsm = self.wsm_network(wsm_)
        
        wsm_energy = torch.cat((wsm_, det_scal, det_vec, det_tens), dim=-1)
        # guga
        weights_sm = torch.softmax(wsm[:, :self.units].reshape(n_atoms * self.units), dim=0)
        scal_mults_th = wsm[:, self.units:self.units * 2].reshape(n_atoms * self.units)

        pos_factors = pos_scalars[:, :self.units].reshape(n_atoms * self.units, 1)
        # Clamp position factors to avoid overflow in the exponential
        pos_factors = torch.clamp(pos_factors, -20, 20)
        print('normalization bleaaa')
        pos_factors_2 = pos_scalars[:, self.units:self.units * 2].reshape(n_atoms * self.units, 1)
        pos_factors_3 = pos_scalars[:, self.units * 2:self.units * 3].reshape(n_atoms * self.units, 1)

        mat_factors = matrix_scalars[:, :self.units].reshape(n_atoms * self.units, 1)
        mat_factors_2 = matrix_scalars[:, self.units:self.units * 2].reshape(n_atoms * self.units, 1)
        mat_factors_3 = matrix_scalars[:, self.units * 2:self.units * 3].reshape(n_atoms * self.units, 1)

        scaling_factors = torch.softmax(torch.cat([mat_factors, mat_factors_2, mat_factors_3], dim=-1), dim=-1)
        #scaling_factors = torch.abs(torch.cat([mat_factors, mat_factors_2, mat_factors_3], dim=-1))
        S1, S2, S3 = scaling_factors[:, 0][:, None, None], scaling_factors[:, 1][:, None, None], scaling_factors[:, 2][:, None, None]
        if self.config['use_pos_disp_functions']:
            X_tens = S1 * self.symm_tensor(X_tens).view(-1, 3, 3) + S2 * self.symm_tensor(X_vec_tens).view(-1, 3,3) + S3 * self.symm_tensor(X_scal_tens).view(-1, 3, 3)
        else:
            X_tens = 0.33*self.symm_tensor(X_tens).view(-1, 3, 3) + 0.33*self.symm_tensor(X_vec_tens).view(-1, 3,3) + 0.33*self.symm_tensor(X_scal_tens).view(-1, 3, 3)

        cov_final = X_tens.view(-1, 3, 3)
        cov_final = self.construct_pos_def(cov_final)
        if not torch.isfinite(cov_final).all():
            logger.warning("Non-finite values in cov_final")
            print('Non-finite values in cov_final')

        if self.config['use_pos_disp_functions']:
            pos_disp_final = pos_disp*torch.exp(pos_factors) + pos_disp_2*torch.square(pos_factors_2) + pos_disp_3 * pos_factors_3
        else:
            pos_disp_final = pos_disp + pos_disp_2 + pos_disp_3
        if wrap:
            # Get the cell matrix as a tensor.
            cell_tensor = torch.tensor(atoms.cell[:], dtype=pos_disp_final.dtype, device=self.device)
            # Get the atomic positions (from atoms.positions) and repeat them per gaussian.
            atom_positions = torch.tensor(atoms.positions, dtype=pos_disp_final.dtype, device=self.device)
            # Here, n_multiples should correspond to the number of gaussians per atom.
            atom_positions_repeated = atom_positions.repeat_interleave(n_multiples, 0)
            # Compute the Gaussian centers.
            gaus_centers = atom_positions_repeated + pos_disp_final
            # Wrap the Gaussian centers into the unit cell.
            #wrapped_centers = minimum_image(gaus_centers, cell_tensor)
            wrapped_centers = wrap_to_cell(gaus_centers, cell_tensor)
            # Adjust the displacements accordingly.
            pos_disp_final = wrapped_centers - atom_positions_repeated
            image_weights = None #torch.abs(self.image_network(wsm_).reshape(27, self.units*n_atoms))
        else:
            image_weights = None
        if not torch.isfinite(pos_disp_final).all():
            logger.warning("Non-finite values in pos_disp_final")
            print('Non-finite values in pos_disp_final')

        pos_disp_features = torch.linalg.norm(pos_disp_final.view(n_atoms, self.units,3),dim=-1)

        input_l0 = wsm_ # needs 4 on energy
        input_l0l1 = torch.cat((input_l0, pos_disp_features), dim=-1) # needs 5 on energy
        input_l0l1l2 = torch.cat((input_l0l1, det_scal, det_vec, det_tens), dim=-1) # needs 8 on energy

        #norm_energy_input = self.energy_layer_norm(energy_input)
        phi_out = self.phi_network(energy_readout_input)
        pooled = phi_out.sum(dim=0)
        energy = self.rho_network(pooled).squeeze(-1)
        
        result = {"cov": cov_final,
                  "pos_disp": pos_disp_final,
                  "weights": weights_sm,
                  "energy": energy,
                  "scal_mults": scal_mults_th,
                  "n_multiples": n_multiples,
                  "cell": torch.tensor(atoms.cell[:]).to(self.device) if atoms.pbc.all() else None,
                  "image_weights": image_weights
                  }

        end = time.time()
        if self.config['wandb']:
            wandb.log({"Forward Time": end - start})
        else:
            print("Forward Time: ", end - start)
        return result

    def symm_tensor(self, matrix):
        symm_matrix = torch.matmul(matrix, matrix.transpose(-1, -2))
        return symm_matrix

    def slice(self, tensor, n_multiples):
        return torch.cat([tensor[i, torch.arange(tensor.size(1))[:num_selections]] for i, num_selections in enumerate(n_multiples)])

    def construct_pos_def(self, matrix: torch.tensor):
        """
        Make a non-positive definite matrix positive definite by adding a small epsilon to its diagonal.

        Args:
            matrix (torch.Tensor): Input matrix.

        Returns:
            torch.Tensor: Positive definite matrix.
        """
        eps = 1e-6  # Small epsilon
        matrix += torch.eye(3, device=self.device).unsqueeze(0).expand(matrix.shape) * eps
        return matrix


    def configure_optimizers(self):
        optimizer = set_optimizer(self, self.config)
        anneal_every = max(1, int(self.config['lr_dec_every']))
        lr_scheduler = torch.optim.lr_scheduler.StepLR(
            optimizer,
            step_size=anneal_every,
            gamma=self.config['lr_gamma'],
        )
        return {
            "optimizer": optimizer,
            "lr_scheduler": {
                "scheduler": lr_scheduler,
                "interval": "epoch",
                "frequency": 1,
            },
        }
    def _apply_warmup_if_needed(self) -> None:
        """Apply linear warmup for the first N optimizer steps across the whole run."""
        n_warmups = int(self.config.get('n_warmups', 0))
        if n_warmups <= 0:
            return

        # Use global_step so warmup happens once for the full training run,
        # not once per epoch.
        warmup_step = int(self.global_step)
        if warmup_step >= n_warmups:
            return

        warmup_scale = float(warmup_step + 1) / float(n_warmups)
        target_lr = self.config['initial_lr'] * warmup_scale
        optimizer = self.optimizers().optimizer
        for param_group in optimizer.param_groups:
            param_group['lr'] = target_lr

    def _log_metrics(self, metrics: dict[str, tuple[torch.Tensor | float, bool]], *, batch_size: int = 1) -> None:
        """Log metrics once per step and once per epoch without double-counting.

        Args:
            metrics: Mapping from metric name to a tuple of (value, show_on_prog_bar).
            batch_size: Batch size for Lightning logging.
        """
        for name, (value, prog_bar) in metrics.items():
            if value is None:
                continue
            self.log(
                f"{name} (step)",
                value,
                on_step=True,
                on_epoch=False,
                prog_bar=prog_bar,
                logger=True,
                batch_size=batch_size,
            )
            self.log(
                name,
                value,
                on_step=False,
                on_epoch=True,
                prog_bar=prog_bar,
                logger=True,
                batch_size=batch_size,
            )

    def _save_model_checkpoint(self):
        if not self.config.get('save_model', False):
            return
        if self.model_handler is None:
            logger.warning("save_model=True but model_handler is None; skipping checkpoint save.")
            return

        trainer = getattr(self, "trainer", None)
        if trainer is not None and not getattr(trainer, "is_global_zero", True):
            return

        self.model_handler.save(self)

    def on_train_epoch_end(self):
        self._save_model_checkpoint()
        print('model saved haha')

    def on_train_epoch_start(self):
        opt = self.optimizers().optimizer
        sch = self.lr_schedulers()
        if isinstance(sch, (list, tuple)):
            sch = sch[0] if sch else None
        print(
            f"[EpochStart] epoch={self.current_epoch} "
            f"lr={opt.param_groups[0]['lr']:.10e} "
            f"last_epoch={None if sch is None else sch.last_epoch}"
        )

    def training_step(self,
                      batch,
                      batch_idx: int):
        self._apply_warmup_if_needed()
        qm9_density, qm9_mol, qm9_n_elec, qm9_grid_dict, filename, pos_grid, *rest = batch[0]
        energy = rest[0] if len(rest) > 0 else None
        atom_count = rest[1] if len(rest) > 1 else None

        molecule_formula = qm9_mol.get_chemical_formula()
        print(f"[Train] Step {batch_idx}: {molecule_formula}")

        if pos_grid is None:
            pos_grid = grid2pos(qm9_mol, qm9_grid_dict)
            pos_grid = pos_grid.to(self.device)
        atom_positions = torch.tensor(qm9_mol.positions, device=self.device)
        start = time.time()
        result = self(qm9_mol, n_elec=qm9_n_elec)
        cell = result['cell']
        weights = result['weights']
        pos_disp = result['pos_disp']
        image_weights = result['image_weights']
        X = result['cov']
        scalar_mults = result['scal_mults']
        n_multiples = result['n_multiples']
        if not self.config['negative_contributions']:
            scalar_mults = None
        weights = weights.reshape(weights.shape[0], 1, 1)

        n_multiples = n_multiples.to(self.device)
        atom_positions = atom_positions.to(self.device)
        atom_positions = atom_positions.reshape(n_multiples.shape[0], -1)
        pos_tens_orig = atom_positions.repeat_interleave(n_multiples, 0).view(-1, 3)
        pos_tens_orig = pos_tens_orig.to(self.device)
        gaus_pos = pos_tens_orig + pos_disp

        sys_dist = gto(
            pos=atom_positions,
            pos_disp=pos_disp,
            cov=X,
